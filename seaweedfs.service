[Unit]
Description=SeaweedFS all-in-one server (S3, Master, Volume, Filer, Admin UI)
Documentation=https://github.com/seaweedfs/seaweedfs/wiki
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=60
ExecStartPre=-/usr/bin/podman rm -f seaweedfs
ExecStart=/usr/bin/podman run \
  --name seaweedfs \
  --cidfile=%t/%n.ctr-id \
  --cgroups=no-conmon \
  --rm \
  --replace \
  -v /srv/seaweedfs/data:/data:Z \
  -v /srv/seaweedfs/entrypoint.sh:/entrypoint.sh:Z,ro \
  -p 8333:8333 \
  -p 9333:9333 \
  -p 9340:9340 \
  -p 8888:8888 \
  -p 7333:7333 \
  -p 23646:23646 \
  --secret seaweedfs-admin-user,type=env,target=WEED_ADMIN_USER \
  --secret seaweedfs-admin-pass,type=env,target=WEED_ADMIN_PASS \
  --secret seaweedfs-s3-key,type=env,target=AWS_ACCESS_KEY_ID \
  --secret seaweedfs-s3-secret,type=env,target=AWS_SECRET_ACCESS_KEY \
  -e S3_BUCKET=my-bucket \
  docker.io/chrislusf/seaweedfs:latest \
  /entrypoint.sh
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm -f --ignore --cidfile=%t/%n.ctr-id
PIDFile=%t/%n.pid

[Install]
WantedBy=multi-user.target
